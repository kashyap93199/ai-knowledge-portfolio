# Public site URL (used for sitemap + canonical URLs)
SITE_URL=http://localhost:3000

# Admin credentials (local only — change these in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-change-me

# Optional: path to the SQLite database file (defaults to ./data/portfolio.db)
DATABASE_PATH=./data/portfolio.db